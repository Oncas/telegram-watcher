{
  "name": "telegram-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches selected Telegram chats and keeps a local record of their posts.",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "telegram-watcher": "src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "smol-toml": "^1.4.2",
    "teleproto": "1.230.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
